{
  "schema": 1,
  "id": "tantalus",
  "name": "Tantalus's Hoard · Hermes",
  "purpose": "Absorbed by Hermes's Hoard. Compatibility identity only; no standalone server. A local product watcher: restocks, price drops, pre-orders and new SKUs at retailers (typed events with a confidence score, revalidation and cooldown), shop-by-shop stock (chains such as Carrefour included) and release days of trading-card products from public stock aggregators, second-hand finds on Wallapop and Facebook Marketplace scored by explainable packs, material news from official pages, feeds and searches, and the sale mails of game stores and book retailers read (read-only) from the Faustus mailbox and matched to wishlists and watchers, plus a mail noise report, with a dashboard of what is new and notifications by Windows toast, the family bus, ntfy, Telegram or email.",
  "capabilities": [
    "restock-watch",
    "price-tracking",
    "price-threshold-alerts",
    "preorder-detection",
    "new-sku-detection",
    "retailer-search-watch",
    "confidence-scoring",
    "revalidation",
    "anti-scalper-policy",
    "fetch-ladder",
    "headless-browser-fallback",
    "needs-human-handoff",
    "product-extraction",
    "json-ld",
    "nvidia-marketplace-api",
    "secondhand-search",
    "wallapop",
    "facebook-marketplace",
    "listing-scoring",
    "free-books-radar",
    "information-sentry",
    "page-diff",
    "feed-watch",
    "web-search",
    "url-discovery",
    "notifications",
    "windows-toast",
    "ntfy",
    "telegram",
    "email",
    "dashboard",
    "declarative-config",
    "mail-deals",
    "mailbox-read-only",
    "wishlist-match",
    "game-store-deals",
    "book-retailer-deals",
    "mail-noise-report",
    "aggregator-radar",
    "release-calendar",
    "shop-stock-by-chain",
    "visible-window-tier",
    "hub-notifications",
    "hub-mail-gateway",
    "family-agenda",
    "purchase-matching",
    "gift-idea-watchers",
    "budget-in-alerts"
  ],
  "placeholders": [
    "TANTALUS_DIR",
    "APP_URL",
    "TOKEN_FILE",
    "PYTHON"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5221/products",
    "TOKEN_FILE": "{TANTALUS_DIR}/data/mcp-token",
    "PYTHON": "{TANTALUS_DIR}/venv/Scripts/python.exe",
    "HERMES_DIR": "{TANTALUS_DIR}/../Hermes's Hoard"
  },
  "app": {
    "url_default": "http://127.0.0.1:5221/products",
    "ui_url": "http://127.0.0.1:5221/",
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "absorbed-tantalus"
      }
    },
    "identify": {
      "service": [
        "tantalus-hoard"
      ],
      "title": [
        "tantalus's hoard",
        "vigilante de productos"
      ]
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{HERMES_DIR}/.venv/Scripts/python.exe",
    "args": [
      "{HERMES_DIR}/mcp_server.py"
    ],
    "env": {
      "HERMES_URL": "http://127.0.0.1:5221",
      "HERMES_TOKEN_FILE": "{HERMES_DIR}/data/mcp-token"
    },
    "optional_env": [
      "HERMES_DATA_DIR"
    ]
  },
  "notes": "Absorbed by Hermes's Hoard: https://github.com/Luissalet/HermesHoard. Compatibility identity only. Start the merged app explicitly and enable its module there. This entry preserves family calls, tokens and existing data; it never owns or stops the merged process.",
  "x-family": {
    "copilot": {
      "contract_version": "1.0",
      "info": "/api/copilot/info",
      "panel": "/api/copilot/panel.js",
      "proxy": "/api/copilot/proxy"
    },
    "fleet": true,
    "agenda": true,
    "absorbed_by": {
      "id": "hermes",
      "repository": "https://github.com/Luissalet/HermesHoard",
      "module": "products",
      "standalone": false
    }
  }
}
